# ---- SpellVision addendum (May 2026) ----
# Rules added after the test foundation and state-machine extraction.
# Reasons inline; remove individually if any rule becomes inconvenient.

# Screenshots/ was historically committed; now excluded.
Screenshots/

# WIP staging area observed at repo root.
_sv_patch/

# Singular output/ (note: existing rule covers plural outputs/).
output/

# Ad-hoc runtime debug dumps observed at repo root.
panel_dump.txt
wan_node_object_info.json
pass*_*.json

# Binary model weights anywhere in the tree (folder rules above cover
# models/ loras/ vae/ etc.; this catches stray weight files elsewhere).
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.gguf
*.onnx

# Patch conflict residue.
*.orig
*.rej

# FreeFileSync sync database (regenerated by the sync tool; never commit).
sync.ffs_db

# HTML prototype mockup export (DevChief .dc.html + support.js + uploads/) — an ad-hoc
# design-capture folder at repo root. The canonical design docs live in docs/design/;
# ignore this export rather than track it (move to docs/mockups/ if it should be versioned).
/SpellVision desktop studio/

# graphify knowledge-graph outputs (regenerable: /graphify .).
graphify-out/
.graphify/

# Agent/tooling scratch state at repo root (not source).
.hermes/

# ---- Generated runtime artifacts (2026-08-25) ----
# ~300MB of PNG/MP4/dataset output produced by the studios and smoke tests.
# Same class as the runtime/imported_workflows + runtime/history rules above:
# regenerable per-machine output, never source.
runtime/characters/
runtime/concept_references/
runtime/proofs/
runtime/state/
runtime/style/
runtime/tmp_inpaint_smoke/

# Local secrets + smoke-test caches. Never commit.
**/credentials.json
runtime/.cache/
python/.cache/

